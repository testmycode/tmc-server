  # pkg:gem/doorkeeper#lib/doorkeeper/oauth/password_access_token_request.rb:43
  def validate_resource_owner; end

  # pkg:gem/doorkeeper#lib/doorkeeper/oauth/password_access_token_request.rb:32
  def validate_scopes; end
end

