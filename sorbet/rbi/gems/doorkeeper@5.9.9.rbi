class Doorkeeper::OAuth::PasswordAccessTokenRequest < ::Doorkeeper::OAuth::BaseRequest
  include ::Doorkeeper::OAuth::Helpers

  # pkg:gem/doorkeeper#lib/doorkeeper/oauth/password_access_token_request.rb:15
