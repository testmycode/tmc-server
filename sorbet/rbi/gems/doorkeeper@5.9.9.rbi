  #
  # pkg:gem/doorkeeper#lib/doorkeeper/config/validations.rb:23
  def validate_reuse_access_token_value; end

  # Validate that the provided strategies are valid for
  # tokens and applications
  #
  # pkg:gem/doorkeeper#lib/doorkeeper/config/validations.rb:37
  def validate_secret_strategies; end

  # pkg:gem/doorkeeper#lib/doorkeeper/config/validations.rb:42
  def validate_token_reuse_limit; end
