  # register now run before any script of its first document. An
  # out-of-process iframe ignores them until the Page domain is enabled.
  #
  # pkg:gem/ferrum#lib/ferrum/contexts.rb:240
  def add_extensions_and_resume(session_id, waiting); end

  # pkg:gem/ferrum#lib/ferrum/contexts.rb:299
  def auto_attach; end

  # Workers have no events to notify us when they're ready, so we
  # connect right away. Worker#prepare enables the Network domain and
