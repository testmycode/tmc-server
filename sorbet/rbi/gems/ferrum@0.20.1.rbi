Ferrum::Frame::Script::WORD = T.let(T.unsafe(nil), Regexp)

# Manages the extra HTTP headers a page sends with its requests, via the
# CDP `Network.setExtraHTTPHeaders` command. Setting a `User-Agent` or
# `Accept-Language` header also updates the corresponding navigator
# override so JavaScript sees consistent values.
#
# pkg:gem/ferrum#lib/ferrum/headers.rb:10
class Ferrum::Headers
  # pkg:gem/ferrum#lib/ferrum/headers.rb:11
  def initialize(page); end

  # Adds given headers to already set ones.
  #
  # @param [Hash{String => String}] headers
  #   key-value pairs for example `"Referer" => "http://example.com"`.
  #
  # @param [Boolean] permanent
  #
  # @return [true]
  #
  # pkg:gem/ferrum#lib/ferrum/headers.rb:58
  def add(headers, permanent: T.unsafe(nil)); end

  # Clear all headers.
  #
  # @return [true]
  #
  # pkg:gem/ferrum#lib/ferrum/headers.rb:43
  def clear; end

  # Get all headers.
  #
  # @return [Hash{String => String}]
  #
  # pkg:gem/ferrum#lib/ferrum/headers.rb:21
  def get; end

  # Set given headers. Eventually clear all headers and set given ones.
  #
  # @param [Hash{String => String}] headers
  #   key-value pairs for example `"User-Agent" => "Browser"`.
  #
  # @return [true]
  #
  # pkg:gem/ferrum#lib/ferrum/headers.rb:33
  def set(headers); end

  private

  # pkg:gem/ferrum#lib/ferrum/headers.rb:75
  def set_overrides(user_agent: T.unsafe(nil), accept_language: T.unsafe(nil), platform: T.unsafe(nil)); end
end

# Shared by {Page} and {Worker}: subscribes to the CDP events behind the
# `:request` (Fetch-domain request interception), `:response` (a request's
# response has fully loaded), `:auth` (proxy/basic auth challenges) and
# `:console` (a new console message) pseudo-events, on top of the
# includer's own `client`, `network` and `console`. Anything else is passed
# straight through to `client`.
#
# pkg:gem/ferrum#lib/ferrum/interceptable.rb:10
module Ferrum::Interceptable
  # Unsubscribes a listener previously registered via {#on}.
  #
  # @param [Symbol, String] name
  #
  # @param [Integer] id
  #   The subscription id returned by {#on}.
  #
  # @return [void]
  #
  # pkg:gem/ferrum#lib/ferrum/interceptable.rb:69
  def off(name, id); end

  # Subscribes to a CDP event, or to `:request`/`:response`/`:auth`/`:console`.
  #
  # @param [Symbol, String] name
  #
  # @yieldparam [Network::InterceptedRequest, Network::Exchange, Network::AuthRequest, Console::Message, Hash] arg
  #   For `:request`, the intercepted {Network::InterceptedRequest}. For
  #   `:response`, the finished {Network::Exchange}. For `:auth`, the
  #   {Network::AuthRequest} challenge. For `:console`, the new
  #   {Console::Message}. For any other (raw CDP) event name, the event's
  #   params `Hash`.
  #
  # @yieldparam [Integer] index
  #   This callback's position among all callbacks currently registered for
  #   the event. Not passed for `:console`.
  #
  # @yieldparam [Integer] total
  #   Total number of callbacks currently registered for the event. Not
  #   passed for `:console`.
  #
  # @return [Integer]
  #   The subscription id, used to unsubscribe via {#off}.
  #
  # @example
  #   page.on(:console) { |message| warn(message) if message.error? }
  #
  # pkg:gem/ferrum#lib/ferrum/interceptable.rb:35
  def on(name, &block); end

  # Whether there's at least one callback registered for the event.
  #
  # @param [String] event
  #
  # @return [Boolean]
  #
  # pkg:gem/ferrum#lib/ferrum/interceptable.rb:89
  def subscribed?(event); end
end

