  # pkg:gem/ferrum#lib/ferrum/contexts.rb:217
  def rearm_auto_attach(session_id, type); end

  # pkg:gem/ferrum#lib/ferrum/contexts.rb:277
  def resume(session_id); end

  # pkg:gem/ferrum#lib/ferrum/contexts.rb:286
