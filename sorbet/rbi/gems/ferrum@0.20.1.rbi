  #
  # @return [Object]
  #
  # pkg:gem/ferrum#lib/ferrum/frame/runtime/legacy.rb:139
  def evaluate_on(node:, expression:, by_value: T.unsafe(nil), wait: T.unsafe(nil)); end

  private

  # Calls that only the new API could have made go the new way.
  #
  # pkg:gem/ferrum#lib/ferrum/frame/runtime/legacy.rb:153
  def legacy?(script, positional, keywords, mode:, on:); end

  # pkg:gem/ferrum#lib/ferrum/frame/runtime/legacy.rb:225
  def legacy_call(expression:, arguments: T.unsafe(nil), on: T.unsafe(nil), wait: T.unsafe(nil), handle: T.unsafe(nil), **options); end

  # pkg:gem/ferrum#lib/ferrum/frame/runtime/legacy.rb:176
