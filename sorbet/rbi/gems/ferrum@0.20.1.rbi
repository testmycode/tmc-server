class Ferrum::Worker
  include ::Ferrum::Frame::Runtime::Legacy
  include ::Ferrum::Frame::Runtime
  include ::Ferrum::Interceptable

  # pkg:gem/ferrum#lib/ferrum/worker.rb:22
