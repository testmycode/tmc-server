  # Delegates any method not defined on `SessionClient` to the underlying
  # {Client}, e.g. `subscribed?`.
  #
  # @return [untyped]
  #
  # pkg:gem/ferrum#lib/ferrum/client.rb:119
  def method_missing(name, *, **, &); end

  # Unsubscribes from a CDP event scoped to this session.
  #
  # @param [String] event
  #   The CDP event name.
  #
  # @param [Integer] id
  #   The subscription id returned by {#on}.
  #
  # @return [void]
  #
  # pkg:gem/ferrum#lib/ferrum/client.rb:90
  def off(event, id); end

  # Subscribes to a CDP event scoped to this session.
  #
  # @param [String] event
  #   The CDP event name.
  #
  # @return [Integer]
  #   The subscription id, used to unsubscribe via {#off}.
  #
  # pkg:gem/ferrum#lib/ferrum/client.rb:75
  def on(event, &); end

  # pkg:gem/ferrum#lib/ferrum/client.rb:18
  def session_id; end

  # Whether there's at least one callback registered for the event, scoped
  # to this session.
