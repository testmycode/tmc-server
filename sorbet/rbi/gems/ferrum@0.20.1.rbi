  # @example
  #   browser.cookies.store # => Integer
  #
  # pkg:gem/ferrum#lib/ferrum/cookies.rb:186
  def store(path = T.unsafe(nil)); end

  private

  # pkg:gem/ferrum#lib/ferrum/cookies.rb:206
  def default_domain; end
end

