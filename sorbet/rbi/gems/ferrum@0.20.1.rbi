  #
  # @return [void]
  #
  # pkg:gem/ferrum#lib/ferrum/console.rb:109
  def off(id); end

  # Calls the block for every new message. Prefer `page.on(:console)`.
  #
  # @yieldparam [Message] message
  #
  # @return [Integer]
  #   The listener id, used to remove it via {#off}.
  #
  # pkg:gem/ferrum#lib/ferrum/console.rb:98
  def on(&block); end

  # Number of collected messages.
  #
  # @return [Integer]
  #
  # pkg:gem/ferrum#lib/ferrum/console.rb:67
  def size; end

  # Subscribes to the CDP events messages are built from.
  #
  # @return [void]
  #
  # pkg:gem/ferrum#lib/ferrum/console.rb:118
  def subscribe; end

  # The collected messages, oldest first.
  #
  # @return [Array<Message>]
  #
  # pkg:gem/ferrum#lib/ferrum/console.rb:49
  def to_a; end

  private

  # pkg:gem/ferrum#lib/ferrum/console.rb:148
