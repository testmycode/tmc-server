    #   The reaped pid, or `nil` if it didn't exit in time or wasn't ours.
    #
    # pkg:gem/ferrum#lib/ferrum/browser/process/killer.rb:82
    def wait_reaped(pid, timeout: T.unsafe(nil)); end
  end
end

