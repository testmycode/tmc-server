  def inspect; end

  # Connects to and returns the {#default_target}'s page.
  #
  # @return [Page]
  #
  # pkg:gem/ferrum#lib/ferrum/context.rb:48
  def page; end

  # All page targets in this context, connected to as {Page}s.
  #
