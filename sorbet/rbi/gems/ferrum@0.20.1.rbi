    def parse(value); end

    # Parses one channel item of `FERRUM_LOG`, warning about an unknown one.
    #
    # @param [String] name
    #
    # @return [Array<Symbol>]
    #
    # pkg:gem/ferrum#lib/ferrum/log.rb:81
    def parse_channel(name); end

    # Parses `FERRUM_LOG_COLOR`, anything but `always` or `never` means `:auto`.
    #
    # @param [String, nil] value
    #
    # @return [Symbol]
    #
    # pkg:gem/ferrum#lib/ferrum/log.rb:109
    def parse_color(value); end

    # Parses `FERRUM_LOG_FORMAT`: `json`, `annotated` or `default`, which is
    # also what an empty or unknown value means.
    #
    # @param [String, nil] value
    #
    # @return [Symbol]
    #
    # pkg:gem/ferrum#lib/ferrum/log.rb:95
    def parse_format(value); end

    # Shortens string values longer than {VALUE_LENGTH} anywhere in a CDP
    # message.
    #
    # @param [Object] value
    #
    # @return [Object]
    #
    # pkg:gem/ferrum#lib/ferrum/log.rb:131
    def truncate(value); end
  end
end

