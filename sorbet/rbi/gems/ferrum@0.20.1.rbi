  def inspect; end

  # The world's name.
  #
  # @return [String]
  #
  # pkg:gem/ferrum#lib/ferrum/isolated_world.rb:18
  def name; end

  # The page the world belongs to.
  #
  # @return [Page]
  #
  # pkg:gem/ferrum#lib/ferrum/isolated_world.rb:28
  def page; end

  private

  # pkg:gem/ferrum#lib/ferrum/isolated_world.rb:90
  def resolve_node_options; end
end

