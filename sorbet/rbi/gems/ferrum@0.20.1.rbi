# A statement that isn't an expression, so it has no value to return.
#
# pkg:gem/ferrum#lib/ferrum/frame/script.rb:65
Ferrum::Frame::Script::STATEMENT = T.let(T.unsafe(nil), Regexp)

# pkg:gem/ferrum#lib/ferrum/frame/script.rb:40
Ferrum::Frame::Script::STRING = T.let(T.unsafe(nil), Regexp)

# pkg:gem/ferrum#lib/ferrum/frame/script.rb:41
Ferrum::Frame::Script::TEMPLATE_CHUNK = T.let(T.unsafe(nil), Regexp)

# Characters ending a value, after which a `/` is a division.
#
# pkg:gem/ferrum#lib/ferrum/frame/script.rb:46
Ferrum::Frame::Script::VALUE_END = T.let(T.unsafe(nil), Regexp)

