  # @return [self] The serializer instance.
  #
  # pkg:gem/readthis#lib/readthis/serializers.rb:91
  def freeze!; end

  # pkg:gem/readthis#lib/readthis/serializers.rb:52
  def inverted; end

  # @private
  #
  # pkg:gem/readthis#lib/readthis/serializers.rb:144
  def marshals; end

  # Find a serializer object by flag value.
  #
  # @param [Number] flag Integer to look up the serializer object by
  # @return [Module] The serializer object
  #
  # @example Find the serializer associated with flag 1
  #
  #   serializers.rassoc(1) #=> Marshal
  #
  # pkg:gem/readthis#lib/readthis/serializers.rb:139
  def rassoc(flag); end

  # Reset the instance back to the default state. Useful for cleanup during
  # testing.
  #
  # @return [self] The serializer instance.
  #
  # pkg:gem/readthis#lib/readthis/serializers.rb:102
  def reset!; end

  # pkg:gem/readthis#lib/readthis/serializers.rb:52
  def serializers; end
end

# Defines the default set of three serializers: Marshal, Passthrough, and
# JSON. With a hard limit of 7 that leaves 4 additional slots.
#
# pkg:gem/readthis#lib/readthis/serializers.rb:42
Readthis::Serializers::BASE_SERIALIZERS = T.let(T.unsafe(nil), Hash)

# The hard serializer limit, based on the number of possible values within
# a single 3bit integer.
#
# pkg:gem/readthis#lib/readthis/serializers.rb:50
Readthis::Serializers::SERIALIZER_LIMIT = T.let(T.unsafe(nil), Integer)

# Raised when attempting to modify the serializers after they have been
# frozen.
#
# pkg:gem/readthis#lib/readthis/errors.rb:12
class Readthis::SerializersFrozenError < ::Readthis::ReadthisError; end

# Raised when attempting to add a new serializer after the limit of 7 is
# reached.
#
# pkg:gem/readthis#lib/readthis/errors.rb:16
class Readthis::SerializersLimitError < ::Readthis::ReadthisError; end

# Raised when an unknown script is called.
#
# pkg:gem/readthis#lib/readthis/errors.rb:19
class Readthis::UnknownCommandError < ::Readthis::ReadthisError; end

# Raised when a serializer was specified, but hasn't been configured for
# usage.
#
# pkg:gem/readthis#lib/readthis/errors.rb:23
class Readthis::UnknownSerializerError < ::Readthis::ReadthisError; end

# pkg:gem/readthis#lib/readthis/version.rb:4
Readthis::VERSION = T.let(T.unsafe(nil), String)
