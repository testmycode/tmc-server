# pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:6
class Doorkeeper::OpenidConnect::OAuth::DynamicRegistrationRequest
  include ::Doorkeeper::Validations
  include ::Doorkeeper::OpenidConnect::TokenEndpointAuthMethodsSupportedMixin
  include ::Doorkeeper::OpenidConnect::GrantTypesSupportedMixin
  extend ::Doorkeeper::Validations::ClassMethods

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:27
  def initialize(server, params); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:50
  def confidential_client?; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:74
  def error_response; end

  # RFC 7591 §2 lets the authorization server replace or omit requested
  # scopes. The requested scope is intersected against the server's
  # configured scopes (default + optional): partially unrecognized
  # scopes are silently dropped, while a request whose scopes are all
  # unsupported is rejected via #validate_scope, since persisting an
  # empty scope set would make Doorkeeper's ScopeChecker fall back to
  # the full server scope set. `Scopes#allowed` honors dynamic scopes
  # and preserves the requested order, but only exists on Doorkeeper
  # 5.8.1+; older versions fall back to plain intersection (dynamic
  # scopes do not exist there, so nothing is lost).
  #
  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:64
  def permitted_scopes; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:36
  def requested_application_type; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:45
  def requested_grant_types; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:40
  def requested_response_types; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:32
  def token_endpoint_auth_method; end

  private

  # RFC 7591 §2: when the request omits `scope`, the authorization
  # server registers the client with its own default set. Doorkeeper
  # has one — `default_scopes` — and registering with no scopes at all
  # is emphatically not it: an application whose `scopes` column is
  # blank is treated as unrestricted by Doorkeeper's ScopeChecker
  # (`app_scopes.presence || server_scopes`), so an omitted `scope`
  # would register a client entitled to every scope the server defines,
  # while a client that honestly declared a narrow scope stays confined
  # to it.
  #
  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:133
  def effective_requested_scopes; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:120
  def requested_scopes; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:80
  def server; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:159
  def server_grant_types; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:155
  def server_response_types; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:163
  def supported_auth_methods; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:91
  def validate_application_type; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:110
  def validate_grant_types; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:100
  def validate_response_types; end

  # A registration must never persist an empty scope set, whichever way
  # it got there: neither an explicit `scope` made up entirely of
  # unsupported values, nor an omitted `scope` on a server that
  # configures no default scopes.
  #
  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:141
  def validate_scope; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/oauth/dynamic_registration_request.rb:82
  def validate_token_endpoint_auth_method; end
end

