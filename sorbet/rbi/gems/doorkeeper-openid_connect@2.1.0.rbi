# Shared helpers for building OpenID Connect provider metadata: issuer
# resolution, `discovery_url_options` handling and namespace-aware endpoint
# URL resolution. Included by the DiscoveryController and, on
# Doorkeeper >= 6.0, by MetadataExtension so the RFC 8414 document built by
# Doorkeeper's own metadata endpoint advertises the same values as the
# OpenID Connect discovery document.
#
# pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:11
module Doorkeeper::OpenidConnect::DiscoveryHelpersMixin
  private

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:63
  def authorization_url_options; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:23
  def claims_supported(openid_connect); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:38
  def discovery_url_default_options; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:34
  def discovery_url_options; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:63
  def dynamic_client_registration_url_options; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:53
  def endpoint_defined?(helper); end

  # Resolves a Doorkeeper URL helper, honouring the namespace under which the
  # engine is mounted. When mounted under a named scope (e.g.
  # `scope :users, as: :users`), the route helpers are prefixed
  # (`users_oauth_authorization_url`); the prefix is supplied as a route
  # default by `use_doorkeeper_openid_connect as: :users`. With no namespace
  # the prefix is empty and the bare helper (`oauth_authorization_url`) is
  # used, preserving the single-mount behaviour.
  #
  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:49
  def endpoint_url(helper, options = T.unsafe(nil)); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:63
  def introspection_url_options; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:19
  def issuer; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:63
  def jwks_url_options; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:29
  def protocol; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:63
  def revocation_url_options; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:57
  def route_helper_prefix; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:63
  def token_url_options; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/discovery_helpers_mixin.rb:63
  def userinfo_url_options; end
end

