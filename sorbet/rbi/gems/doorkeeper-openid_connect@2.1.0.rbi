  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:133
  def apply_prompt_to_non_oidc_requests(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:97
  def auth_time_from_access_token(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:92
  def auth_time_from_resource_owner(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:96
  def auth_time_from_session(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:135
  def authorize_dynamic_client_registration(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:79
  def builder_class; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:113
  def claims(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:123
  def discovery_url_options(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:127
  def dynamic_client_registration(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:119
  def end_session_endpoint(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:111
  def expiration(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:147
  def id_token_class(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:163
  def id_token_model; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:83
  def issuer(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:137
  def open_id_request_class(*_args); end

  # Doorkeeper OpenID Request model class.
  #
  # @return [ActiveRecord::Base, Mongoid::Document, Sequel::Model]
  #
  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:159
  def open_id_request_model; end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:115
  def protocol(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:99
  def reauthenticate_resource_owner(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:88
  def resource_owner_from_access_token(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:103
  def select_account_for_resource_owner(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:85
  def signing_algorithm(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:84
  def signing_key(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:107
  def subject(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:86
  def subject_types_supported(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:153
  def user_info_class(*_args); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:167
  def user_info_model; end

  private

  # Resolves an `id_token_class` / `user_info_class` override to its class
  # and validates that it inherits from the corresponding default. The
  # ancestry check replaced the earlier method-presence list: presence
  # could be satisfied by any class (ActiveSupport defines `as_json` on
  # `Object`), while inheritance also carries the security-critical
  # behavior — required-claim enforcement, the claim merge order, nonce
  # and `at_hash` handling — that a from-scratch implementation would
  # have to reproduce. Both resolution and validation happen lazily at
  # first use rather than inside `Doorkeeper::OpenidConnect.configure`:
  # constantizing an app-defined class while initializers run breaks
  # zeitwerk on Rails 7+, because reloadable constants must not be
  # referenced during boot — the same reason `open_id_request_model`
  # constantizes lazily. The class is also deliberately not memoized, so
  # code reloading in development never hands back a stale class; only
  # the validation result is cached, keyed on the resolved class so a
  # reloaded class is re-validated.
  #
  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:189
  def resolve_validated_model(kind, class_name, base_model); end

  # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:206
  def validate_model_inheritance!(kind, class_name, model, base_model); end

  class << self
    # pkg:gem/doorkeeper-openid_connect#lib/doorkeeper/openid_connect/config.rb:79
    def builder_class; end
  end
end

