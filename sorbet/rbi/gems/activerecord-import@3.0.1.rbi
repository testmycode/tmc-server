  def ids_and_results_from_returned_values(returned_values, options); end

  # pkg:gem/activerecord-import#lib/activerecord-import/adapters/abstract_adapter.rb:118
  def increment_locking_column!(table_name, results, locking_column); end

  # pkg:gem/activerecord-import#lib/activerecord-import/adapters/abstract_adapter.rb:9
