    # pkg:gem/activerecord-import#lib/activerecord-import/import.rb:1364
    def validate_hash_import(hash, required_keys, allow_extra_keys); end

    # Returns an Array of Hashes for the passed in +column_names+ and +array_of_attributes+.
    #
    # pkg:gem/activerecord-import#lib/activerecord-import/import.rb:1357
    def validations_array_for_column_names_and_attributes(column_names, array_of_attributes); end

    # A model of another class, such as an STI subclass with its own enum, can give
    # a column a different type than this class, which serializes the imported values.
    # Convert the model's value to this class's type through its database value.
    #
    # pkg:gem/activerecord-import#lib/activerecord-import/import.rb:1189
