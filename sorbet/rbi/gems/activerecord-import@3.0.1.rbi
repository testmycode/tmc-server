# pkg:gem/activerecord-import#lib/activerecord-import/core.rb:8
module ActiveRecord::Import
  class << self
    # pkg:gem/activerecord-import#lib/activerecord-import/core.rb:12
    def base_adapter(adapter); end

    # Aliases +import+ and +import!+ to +bulk_import+ and +bulk_import!+, unless
    # they are already defined or aliases have been skipped.
    #
    # pkg:gem/activerecord-import#lib/activerecord-import/aliases.rb:14
    def define_aliases; end

    # Loads the import functionality for the passed in ActiveRecord connection
    #
    # pkg:gem/activerecord-import#lib/activerecord-import/core.rb:35
    def load_from_connection_pool(connection_pool); end

    # Loads the import functionality for the passed in ActiveRecord connection,
    # unless it's been tried for the connection's adapter already. Import uses
    # this when activerecord-import was required after the connection was
    # established. Each adapter is only tried once, so an unsupported adapter
    # doesn't search the load path on every import.
    #
    # pkg:gem/activerecord-import#lib/activerecord-import/core.rb:44
    def load_from_connection_pool_once(connection_pool); end

    # Loads the import functionality for a specific database adapter
    #
    # pkg:gem/activerecord-import#lib/activerecord-import/core.rb:28
    def require_adapter(adapter); end

    # Prevents the +import+ and +import!+ aliases from being defined, and removes
    # them if they already have been. Used by "activerecord-import/without_aliases".
    #
    # pkg:gem/activerecord-import#lib/activerecord-import/aliases.rb:26
    def skip_aliases!; end

    # pkg:gem/activerecord-import#lib/activerecord-import/aliases.rb:39
    def skip_aliases?; end

    private

    # pkg:gem/activerecord-import#lib/activerecord-import/core.rb:52
    def adapter_for(connection_pool); end
  end
end

