# This is a 'custom' Web Socket server that is designed to be synchronous. What
# this means is that it sends a message, and then waits for a response. It does
# not expect to receive a message at any other time than right after it has sent
# a message. So it is basically operating a request/response cycle (which is not
# how Web Sockets are usually used, but it's what we want here, as we want to
# send a message to PhantomJS and then wait for it to respond).
#
# pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:13
class Capybara::Poltergeist::WebSocketServer
  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:26
  def initialize(port = T.unsafe(nil), timeout = T.unsafe(nil), custom_host = T.unsafe(nil)); end

  # Accept a client on the TCP server socket, then receive its initial HTTP request
  # and use that to initialize a Web Socket.
  #
  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:56
  def accept; end

  # Closing sockets separately as `close_read`, `close_write`
  # causes IO mistakes on JRuby, using just `close` fixes that.
  #
  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:107
  def close; end

  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:50
  def connected?; end

  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:23
  def driver; end

  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:23
  def host; end

  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:23
  def port; end

  # Block until the next message is available from the Web Socket.
  # Raises Errno::EWOULDBLOCK if timeout is reached.
  #
  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:74
  def receive(cmd_id, receive_timeout = T.unsafe(nil)); end

  # Send a message and block until there is a response
  #
  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:97
  def send(cmd_id, message, accept_timeout = T.unsafe(nil)); end

  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:23
  def server; end

  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:23
  def socket; end

  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:32
  def start_server(port, custom_host); end

  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:24
  def timeout; end

  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:24
  def timeout=(_arg0); end

  # pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:68
  def write(data); end
end

# How many seconds to try to bind to the port for before failing
#
# pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:19
Capybara::Poltergeist::WebSocketServer::BIND_TIMEOUT = T.let(T.unsafe(nil), Integer)

# pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:21
Capybara::Poltergeist::WebSocketServer::HOST = T.let(T.unsafe(nil), String)

# How much to try to read from the socket at once (it's kinda arbitrary because we
# just keep reading until we've received a full frame)
#
# pkg:gem/poltergeist#lib/capybara/poltergeist/web_socket_server.rb:16
Capybara::Poltergeist::WebSocketServer::RECV_SIZE = T.let(T.unsafe(nil), Integer)
