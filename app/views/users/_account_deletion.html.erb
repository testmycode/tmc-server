<% if user == current_user %>
  <% if (deletion_url = User.courses_mooc_fi_account_deletion_url) %>
    <%= link_to 'Delete account on courses.mooc.fi', deletion_url, class: 'btn btn-danger', target: '_top' %>
  <% else %>
    <p>To delete your account, please contact support.</p>
  <% end %>
<% end %>
