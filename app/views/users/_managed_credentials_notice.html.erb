<% if user == current_user %>
  <div class="alert alert-info" role="alert">
    Your email address and password are managed on courses.mooc.fi.
    <% if (settings_url = User.courses_mooc_fi_account_settings_url) %>
      <%= link_to 'Change them in your account settings on courses.mooc.fi', settings_url, target: '_top' %>.
    <% end %>
  </div>
<% else %>
  <p>This user changes their email address and password on courses.mooc.fi.</p>
<% end %>
