<% if user == current_user %>
  <% settings_url = User.courses_mooc_fi_account_settings_url %>
  <div class="alert alert-info" role="alert">
    Your email address and password are managed on courses.mooc.fi.
    <% if settings_url %>
      <%# _top: the user's own account page can be embedded in another site's iframe. %>
      <%= link_to 'Change them in your account settings on courses.mooc.fi', settings_url, target: '_top' %>.
    <% end %>
  </div>
<% else %>
  <% profile_url = user.courses_mooc_fi_profile_url %>
  <p>
    This user's email address and password are changed on courses.mooc.fi, where admins can also edit them.
    <% if profile_url && current_user.administrator? %>
      <%= link_to 'Open this user on courses.mooc.fi', profile_url, target: '_blank', rel: 'noopener' %>.
    <% end %>
  </p>
<% end %>
